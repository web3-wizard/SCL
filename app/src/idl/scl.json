{
  "version": "0.1.0",
  "name": "scl",
  "instructions": [
    {
      "name": "initializeRegistry",
      "accounts": [
        { "name": "registry", "isMut": true, "isSigner": false },
        { "name": "owner", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "oraclePubkey", "type": "publicKey" },
        { "name": "travelRuleThreshold", "type": "u64" }
      ]
    },
    {
      "name": "registerVasp",
      "accounts": [
        { "name": "registry", "isMut": true, "isSigner": false },
        { "name": "owner", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "vaspPubkey", "type": "publicKey" },
        { "name": "name", "type": "string" },
        { "name": "jurisdiction", "type": "string" },
        { "name": "encryptionKey", "type": { "array": ["u8", 32] } }
      ]
    },
    {
      "name": "transferCompliant",
      "accounts": [
        { "name": "registry", "isMut": false, "isSigner": false },
        { "name": "sender", "isMut": true, "isSigner": true },
        { "name": "senderTokenAccount", "isMut": true, "isSigner": false },
        { "name": "recipientTokenAccount", "isMut": true, "isSigner": false },
        { "name": "mint", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "instructionsSysvar", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "amount", "type": "u64" },
        { "name": "decimals", "type": "u8" },
        { "name": "attestationWallet", "type": "publicKey" },
        { "name": "attestationExpiry", "type": "i64" },
        { "name": "attestationLevel", "type": "u8" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "VaspRegistry",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "oraclePubkey", "type": "publicKey" },
          { "name": "travelRuleThreshold", "type": "u64" },
          { "name": "vaspCount", "type": "u32" },
          { "name": "vasps", "type": { "vec": { "defined": "VaspEntry" } } }
        ]
      }
    }
  ],
  "types": [
    {
      "name": "VaspEntry",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "vaspPubkey", "type": "publicKey" },
          { "name": "name", "type": "string" },
          { "name": "jurisdiction", "type": "string" },
          { "name": "encryptionKey", "type": { "array": ["u8", 32] } }
        ]
      }
    }
  ],
  "errors": [
    { "code": 6000, "name": "AttestationWalletMismatch", "msg": "Attestation wallet does not match the transfer sender" },
    { "code": 6001, "name": "AttestationExpired", "msg": "Attestation has expired" },
    { "code": 6002, "name": "MissingTravelRulePayload", "msg": "Travel Rule payload is required for transfers at or above the threshold" },
    { "code": 6003, "name": "VaspAlreadyExists", "msg": "VASP with this public key already exists in the registry" },
    { "code": 6004, "name": "Unauthorized", "msg": "Only the registry owner can perform this action" },
    { "code": 6005, "name": "MissingEd25519Instruction", "msg": "Ed25519 signature verification instruction not found" },
    { "code": 6006, "name": "InvalidSignatureVerification", "msg": "Ed25519 signature verification failed" },
    { "code": 6007, "name": "InvalidAttestationMessage", "msg": "Invalid attestation message format" }
  ]
}
