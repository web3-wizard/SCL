# Frontend Environment Variables
# Copy to .env.local for local development
# Set in Vercel dashboard for production

# Oracle URL
VITE_ORACLE_URL=http://localhost:3001

# For production, set to your deployed Oracle URL:
# VITE_ORACLE_URL=https://your-oracle.railway.app

# SCL Program ID (update after deployment)
VITE_SCL_PROGRAM_ID=11111111111111111111111111111111

# Solana Cluster
VITE_SOLANA_CLUSTER=devnet
